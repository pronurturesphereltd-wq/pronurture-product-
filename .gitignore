# Environment / secrets
.env
.env.*
!.env.example

# Credential files. A Firebase service account JSON carries a private key
# granting admin access to the project, so these are matched by name wherever
# they land rather than relying on remembering to keep them out of the tree.
# Note: `secrets/*` not `secrets/` — git cannot re-include a file whose parent
# directory is excluded, and the README carries the setup instructions.
secrets/*
!secrets/README.txt
*firebase*.json
*service-account*.json
*serviceAccount*.json
*-credentials.json

# Virtualenv
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Django
*.log
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
/staticfiles/
/media/

