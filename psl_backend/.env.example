# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres.
# Supabase dashboard > Connect > Session pooler > URI (port 5432, NOT the
# transaction pooler on 6543 — migrations need prepared statements).
# Percent-encode the password if it contains any of  : / ? # [ ] @ ! $ & ' ( ) * + , ; =
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth — JWT Signing Keys (asymmetric).
# Tokens are verified against the project's public JWKS endpoint, which is
# derived from this URL. No shared secret is required or stored.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Optional overrides:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_LEEWAY_SECONDS=10
# SUPABASE_JWKS_CACHE_SECONDS=300

# --- Phase 1A ---

# Supabase secret key — new format, starts sb_secret_
# Dashboard > Project Settings > API Keys > Secret keys > Create new.
# Bulk import uses it to provision an auth account and send a login email per
# imported professional. SECRET — bypasses RLS, server only, never in a browser.
# Blank: imports still create Profile rows, just without accounts.
SUPABASE_SECRET_KEY=

# Legacy fallback only. The service_role JWT still works but Supabase is
# retiring it; prefer SUPABASE_SECRET_KEY above for new deployments.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback

# Firebase service account JSON for push (Firebase Console > Project Settings
# > Service accounts > Generate new private key). Save it under
# psl_backend/secrets/, which is git-ignored in full — the file contains a
# private key granting admin access to the Firebase project.
# A relative path resolves against the directory holding manage.py.
# Blank: push sends are skipped with a warning rather than raising.
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json

# 0 lets an unapproved facility use rota/import endpoints. Default 1.
PSL_REQUIRE_APPROVED_FACILITY=1

# Shift reminders. Keep the window wider than the interval so no shift slips
# between two sweeps.
SHIFT_REMINDER_LEAD_MINUTES=60
SHIFT_REMINDER_WINDOW_MINUTES=20
SHIFT_REMINDER_INTERVAL_MINUTES=15

# Bulk import limits.
BULK_IMPORT_MAX_BYTES=5242880
BULK_IMPORT_MAX_ROWS=5000
