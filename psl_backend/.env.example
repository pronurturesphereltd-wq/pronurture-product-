# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres.
# Supabase dashboard > Connect > Session pooler > URI (port 5432, NOT the
# transaction pooler on 6543 — migrations need prepared statements).
# Percent-encode the password if it contains any of  : / ? # [ ] @ ! $ & ' ( ) * + , ; =
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth — JWT Signing Keys (asymmetric).
# Tokens are verified against the project's public JWKS endpoint, which is
# derived from this URL. No shared secret is required or stored.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Optional overrides:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_LEEWAY_SECONDS=10
# SUPABASE_JWKS_CACHE_SECONDS=300
