# Copy to .env.local and fill in. Every NEXT_PUBLIC_ value is bundled into
# browser code — that is deliberate here. None of these are secrets.
#
# The backend's psl_backend/.env is the opposite: nothing there may be exposed.
# Never put SUPABASE_SECRET_KEY or the service account JSON in this file.

NEXT_PUBLIC_SUPABASE_URL=https://eypxxfwclqzfvbdozmeb.supabase.co

# Supabase Dashboard > Project Settings > API Keys > Publishable key.
# Starts sb_publishable_. This is the client-safe key, NOT sb_secret_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Django backend. 127.0.0.1 rather than localhost: the backend's
# DJANGO_ALLOWED_HOSTS lists both, but they are distinct origins to the browser.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
